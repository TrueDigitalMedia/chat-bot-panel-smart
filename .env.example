# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres (Dashboard → Connection string → pooled / serverless)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Mock registration outcome webhook (local/dev)
REGISTRATION_WEBHOOK_SECRET=dev-registration-secret
APP_BASE_URL=http://localhost:3000

# Client MySQL — lead sync + registration code lookup (see contracts/client-mysql-integration.md)
# When false/unset, bot keeps local MOCK-… code path
CLIENT_MYSQL_SYNC_ENABLED=false
# CLIENT_MYSQL_HOST=
# CLIENT_MYSQL_PORT=3306
# CLIENT_MYSQL_USER=
# CLIENT_MYSQL_PASSWORD=
# CLIENT_MYSQL_DATABASE=
# CLIENT_MYSQL_LEADS_TABLE=
# CLIENT_MYSQL_CODE_COLUMN=

# OpenAI (chat: gpt-5-nano, embeddings: text-embedding-3-small)
OPENAI_API_KEY=

# Support & Content
SUPPORT_CONTACT=555555555
THANK_YOU_VIDEO_URL=
ONBOARDING_VIDEO_URL=

# Admin panel (/admin/quotas) — HTTP Basic Auth, user is always "admin"
# Unset = panel and /api/admin/* always return 401 (fails closed)
ADMIN_PASSWORD=

# NSE CAM reverse geocode (optional; defaults to public Nominatim)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# WhatsApp provider: meta (WhatsApp Business Cloud API, default) | twilio
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (primary) — Meta Developer App → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=   # you choose; same value in Meta webhook config
# WHATSAPP_APP_SECRET=     # App settings → Basic → App Secret (signature)
# WHATSAPP_GRAPH_VERSION=v21.0
# Webhook URL in Meta: https://<your-host>/api/webhooks/whatsapp  (GET verify + POST)

# Twilio WhatsApp (alternative) — set WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WEBHOOK_URL=https://<your-host>/api/webhooks/whatsapp/twilio
# Join sandbox from phone: send Twilio join code to the sandbox number

# Optional test overrides
# RE_ENGAGEMENT_TIMEOUT_OVERRIDE_SECONDS=10
# RE_ENGAGEMENT_CADENCE_OVERRIDE_SECONDS=30,60,90
# FORCE_EXTRACTION_ERROR=fieldName
