# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres (Dashboard → Connection string → pooled / serverless)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Mock registration (no PanelSmart)
REGISTRATION_WEBHOOK_SECRET=dev-registration-secret
APP_BASE_URL=http://localhost:3000

# OpenAI (chat: gpt-5-nano, embeddings: text-embedding-3-small)
OPENAI_API_KEY=

# Support & Content
SUPPORT_CONTACT=555555555
THANK_YOU_VIDEO_URL=
ONBOARDING_VIDEO_URL=

# Quota mock (no external API)
# Leave unset = random 50/50 per conversation (stable for the same lead)
# Force for tests: true | false
# QUOTA_MOCK_AVAILABLE=true

# Optional test overrides
