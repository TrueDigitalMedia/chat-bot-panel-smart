# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres (Dashboard → Connection string → pooled / serverless)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Mock registration outcome webhook (local/dev)
REGISTRATION_WEBHOOK_SECRET=dev-registration-secret
APP_BASE_URL=http://localhost:3000

# Client MySQL (TDM/Kantar) — lead sync + registration_code lookup against
# tb_leads_agente_ia (see specs/010-tdm-lead-sync). When false/unset, sync is a no-op.
CLIENT_MYSQL_SYNC_ENABLED=false
# CLIENT_MYSQL_HOST=
# CLIENT_MYSQL_PORT=3306
# CLIENT_MYSQL_USER=
# CLIENT_MYSQL_PASSWORD=
# CLIENT_MYSQL_DATABASE=
# CLIENT_MYSQL_TENANT_ID=
# CLIENT_MYSQL_LEAD_VERSION=
# CLIENT_MYSQL_SSL_CA=

# TDM's registration-code endpoint isn't live yet — set true to deliver a mock code
# (MOCK-XXXXXXXX) instead of requesting one from TDM. Flip to false once
# TDM_REGISTRATION_REQUEST_URL below is real.
REGISTRATION_CODE_MOCK_ENABLED=true

# TDM registration-code request+webhook (replaces the old MySQL poll — see
# specs/001-panelsmart-recruitment-bot/contracts/client-mysql-integration.md §2b).
# TDM_REGISTRATION_REQUEST_URL=        # TBD — TDM-provided
# TDM_REGISTRATION_REQUEST_AUTH_HEADER=  # TBD — TDM-provided (e.g. Authorization, X-API-Key)
# TDM_REGISTRATION_REQUEST_AUTH_VALUE=   # TBD — TDM-provided
TDM_REGISTRATION_CODE_TIMEOUT_SECONDS=1800
TDM_REGISTRATION_WEBHOOK_SECRET=dev-tdm-registration-secret

# Panel Smart / Kantar ai-lead-responses — same Azure Function App + OAuth tenant as
# TDM_REGISTRATION_REQUEST_URL above (TDM_OAUTH_*), different endpoint. Pushes per-question
# survey/ficha-hogar answers as {codigo_pregunta, pregunta, respuesta}. When false/unset, sync
# is a no-op.
PANEL_SMART_SYNC_ENABLED=false
# PANEL_SMART_SYNC_URL=        # TBD — Kantar-provided (.../api/ai-lead-responses)

# QStash recurring schedule auth for the 3-hourly abandoned-conversation sync sweep
# (jobs/panel-smart-abandoned-sync) — configured via `upstash qstash schedule create`.
# See src/app/api/jobs/panel-smart-abandoned-sync/QSTASH_SETUP.md for setup instructions.
# CRON_SECRET=

# OpenAI (chat: gpt-5-nano, embeddings: text-embedding-3-small)
OPENAI_API_KEY=

# Support & Content
SUPPORT_CONTACT=555555555
THANK_YOU_VIDEO_URL=
ONBOARDING_VIDEO_URL=

# Admin area (/admin/*) — login form at "/", session cookie gate
# Unset ADMIN_PASSWORD or SESSION_SECRET = login always fails / no session verifies (fails closed)
ADMIN_PASSWORD=
SESSION_SECRET=

# NSE CAM reverse geocode (optional; defaults to public Nominatim)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# WhatsApp provider: meta (WhatsApp Business Cloud API, default) | twilio
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (primary) — Meta Developer App → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=   # you choose; same value in Meta webhook config
# WHATSAPP_APP_SECRET=     # App settings → Basic → App Secret (signature)
# WHATSAPP_GRAPH_VERSION=v21.0
# Webhook URL in Meta: https://<your-host>/api/webhooks/whatsapp  (GET verify + POST)

# Twilio WhatsApp (alternative) — set WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WEBHOOK_URL=https://<your-host>/api/webhooks/whatsapp/twilio
# Join sandbox from phone: send Twilio join code to the sandbox number

# Optional test overrides
# RE_ENGAGEMENT_TIMEOUT_OVERRIDE_SECONDS=10
# RE_ENGAGEMENT_CADENCE_OVERRIDE_SECONDS=30,60,90
# LINK_SENT_REMINDER_DELAY_SECONDS_OVERRIDE=30
# FORCE_EXTRACTION_ERROR=fieldName
