{
  "name": "panelsmart-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed:faqs": "tsx --env-file=.env src/lib/db/seed/faqs.ts",
    "db:seed:evals": "tsx --env-file=.env src/lib/db/seed/eval-fixtures.ts",
    "eval:backfill": "tsx --env-file=.env src/lib/eval/run-backfill.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/qstash": "^2.11.1",
    "ai": "^7.0.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.23.1",
    "next": "16.2.10",
    "postcss": "^8.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twilio": "^3.19.2",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.61.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
